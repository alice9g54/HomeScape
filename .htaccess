# ============================================================
# HOMESCAPE REAL ESTATE - APACHE CONFIGURATION
# ============================================================
# Purpose: Security headers, redirects, caching, compression
# Last Updated: September 2026
# ============================================================

# ============================================================
# 1. FORCE HTTPS
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  
  # Redirect www to non-www (or vice versa — pick one)
  RewriteCond %{HTTP_HOST} ^www\.homescape\.co\.ke [NC]
  RewriteRule ^(.*)$ https://homescape.co.ke/$1 [L,R=301]
</IfModule>

# ============================================================
# 2. SECURITY HEADERS
# ============================================================
<IfModule mod_headers.c>
  
  # Prevent MIME sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Prevent clickjacking
  Header set X-Frame-Options "SAMEORIGIN"
  
  # XSS Protection (legacy browsers)
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Permissions Policy
  Header set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
  
  # Content Security Policy
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; img-src 'self' data: https://images.unsplash.com https://placehold.co; media-src 'self' blob:; frame-src 'self' https://www.google.com https://www.youtube-nocookie.com; connect-src 'self'; form-action 'self'; base-uri 'self';"
  
  # HSTS (HTTPS only - 1 year)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
  
</IfModule>

# ============================================================
# 3. PROTECT SENSITIVE FILES
# ============================================================

# Block access to .htaccess itself
<Files ".htaccess">
  Require all denied
</Files>

# Block access to environment files
<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

# Block access to package files
<FilesMatch "^(package|package-lock|yarn)\.json$">
  Require all denied
</FilesMatch>

# Block access to markdown files
<FilesMatch "\.(md|markdown)$">
  Require all denied
</FilesMatch>

# Block access to log files
<FilesMatch "\.(log|txt)$">
  Require all denied
</FilesMatch>

# Block access to config files
<FilesMatch "\.(ini|conf|config)$">
  Require all denied
</FilesMatch>

# Block access to backup files
<FilesMatch "\.(bak|backup|old|orig|save|swp|swo)$">
  Require all denied
</FilesMatch>

# ============================================================
# 4. PROTECT SENSITIVE DIRECTORIES
# ============================================================

# Block access to /data/ directory (JSON files should be served via API, not directly)
<IfModule mod_rewrite.c>
  RewriteRule ^data/ - [F,L]
</IfModule>

# Block access to /config/ directory
<IfModule mod_rewrite.c>
  RewriteRule ^config/ - [F,L]
</IfModule>

# Block access to /backend/ directory
<IfModule mod_rewrite.c>
  RewriteRule ^backend/ - [F,L]
</IfModule>

# ============================================================
# 5. BLOCK BAD BOTS & SCRAPERS
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Block common bad bots
  RewriteCond %{HTTP_USER_AGENT} (ahrefs|semrush|mj12bot|dotbot|petalbot|bytespider) [NC]
  RewriteRule .* - [F,L]
  
  # Block empty user agents (often scrapers)
  RewriteCond %{HTTP_USER_AGENT} ^-?$
  RewriteRule .* - [F,L]
</IfModule>

# ============================================================
# 6. BLOCK BAD REFERRERS
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  RewriteCond %{HTTP_REFERER} (semalt|buttons-for-website|social-buttons|kambasoft) [NC]
  RewriteRule .* - [F,L]
</IfModule>

# ============================================================
# 7. CUSTOM ERROR PAGES
# ============================================================
ErrorDocument 400 /404.html
ErrorDocument 401 /404.html
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html
ErrorDocument 502 /404.html
ErrorDocument 503 /404.html

# ============================================================
# 8. COMPRESSION (GZIP)
# ============================================================
<IfModule mod_deflate.c>
  
  # Compress HTML, CSS, JS, Text, XML, Fonts
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  
  # Remove browser bugs
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
  BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
  Header append Vary User-Agent
  
</IfModule>

# ============================================================
# 9. BROWSER CACHING
# ============================================================
<IfModule mod_expires.c>
  
  ExpiresActive On
  
  # HTML - 1 hour (content changes often)
  ExpiresByType text/html "access plus 1 hour"
  
  # CSS & JS - 1 year (use versioning in URLs)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  
  # Images - 1 year
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # Fonts - 1 year
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  
  # Videos - 1 month
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType video/ogg "access plus 1 month"
  
  # Manifest & XML - 1 day
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
  
  # JSON - 1 hour (data changes often)
  ExpiresByType application/json "access plus 1 hour"
  
</IfModule>

<IfModule mod_headers.c>
  
  # Cache-Control headers for better browser support
  <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|otf|eot|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  <FilesMatch "\.(mp4|webm|ogg)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  <FilesMatch "\.(json|xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  
</IfModule>

# ============================================================
# 10. DISABLE DIRECTORY LISTING
# ============================================================
Options -Indexes

# ============================================================
# 11. DISABLE SERVER SIGNATURE
# ============================================================
ServerSignature Off

# ============================================================
# 12. PROTECT AGAINST COMMON ATTACKS
# ============================================================

# Block suspicious query strings
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Block SQL injection attempts
  RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} proc/self/environ [OR]
  RewriteCond %{QUERY_STRING} mosConfig_[a-zA-Z_]{1,21}(=|\%3D) [OR]
  RewriteCond %{QUERY_STRING} base64_encode.*\(.*\) [OR]
  RewriteCond %{QUERY_STRING} (<|%3C).*iframe.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} (\.\./|%2e%2e) [NC]
  RewriteRule ^(.*)$ - [F,L]
  
  # Block PHP injection attempts
  RewriteCond %{QUERY_STRING} [^a-z](declare|char|set|cast|convert|delete|drop|truncate)[^a-z] [NC]
  RewriteRule ^(.*)$ - [F,L]
  
  # Block file injection attempts
  RewriteCond %{REQUEST_URI} (\.\./|\.\.\\) [NC]
  RewriteRule ^(.*)$ - [F,L]
</IfModule>

# ============================================================
# 13. PREVENT HOTLINKING (IMAGES)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?homescape\.co\.ke [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\.com [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bing\.com [NC]
  RewriteRule \.(jpg|jpeg|png|gif|svg|webp)$ - [F,NC,L]
</IfModule>

# ============================================================
# 14. MIME TYPES
# ============================================================
<IfModule mod_mime.c>
  
  # Web fonts
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/font-woff .woff
  AddType application/x-font-ttf .ttf
  AddType font/opentype .otf
  AddType application/vnd.ms-fontobject .eot
  
  # Videos
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/ogg .ogv
  
  # Images
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType image/avif .avif
  
  # Data
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  
</IfModule>

# ============================================================
# 15. REDIRECTS (SEO)
# ============================================================

# Redirect old URLs to new ones
Redirect 301 /estate-tours.html /video-tours.html
Redirect 301 /properties /properties.html
Redirect 301 /property /properties.html
Redirect 301 /about /about.html
Redirect 301 /contact /contact.html

# ============================================================
# END OF .HTACCESS
# ============================================================