{
  "name": "HomeScape - Luxury Real Estate Kenya",
  "short_name": "HomeScape",
  "description": "Discover luxury properties, commercial spaces, and investment opportunities across Kenya. Cinematic 4K tours, verified listings, and expert guidance.",
  "lang": "en-KE",
  "dir": "ltr",
  "id": "/?source=pwa",
  "start_url": "/index.html?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0a0f1c",
  "theme_color": "#047857",
  "categories": ["business", "lifestyle", "shopping", "real-estate"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "scope_extensions": [
    { "type": "origin", "origin": "https://homescape.co.ke" }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+homescape",
      "url": "/index.html?action=%s"
    }
  ],
  "share_target": {
    "action": "/share.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
